<IfModule mod_alias.c>
    ScriptAlias /cgi-bin/ "@ServerRoot@/cgi-bin/"
</IfModule>



<Directory "@ServerRoot@/cgi-bin">
   AllowOverride None
   Options None
</Directory>

<IfModule !mpm_prefork_module>
    LoadModule mpm_prefork_module "@APACHE2_MODULE_DIR@/mod_mpm_prefork.so"
</IfModule>

<IfModule !authz_core_module>
    LoadModule authz_core_module "@APACHE2_MODULE_DIR@/mod_authz_core.so"
</IfModule>
